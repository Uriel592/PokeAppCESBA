<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A202C"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Battle Versus (1v1 Local)"
        android:textColor="#F6E05E"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Panel de Jugadores -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#2D3748"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jugador 1"
                android:textColor="#3182CE"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbP1Hp"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="4dp"
                android:progress="100"
                android:progressTint="#48BB78" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="VS"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jugador 2"
                android:textColor="#E53E3E"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbP2Hp"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="4dp"
                android:progress="100"
                android:progressTint="#48BB78" />
        </LinearLayout>
    </LinearLayout>

    <!-- Indicador de Turno -->
    <TextView
        android:id="@+id/tvTurnIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Turno: Jugador 1"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Registro de Batalla -->
    <TextView
        android:id="@+id/tvVersusLog"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:background="#2D3748"
        android:padding="12dp"
        android:text="Comienza la batalla multijugador. ¡Jugador 1 ataca primero!"
        android:textColor="#E2E8F0"
        android:textSize="14sp" />

    <!-- Botones de Acción -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:alignmentMode="alignMargins"
        android:columnCount="2"
        android:rowCount="2">

        <Button
            android:id="@+id/btnVersusAttack1"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:backgroundTint="#3182CE"
            android:text="Ataque Fuerte (25)" />

        <Button
            android:id="@+id/btnVersusAttack2"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:backgroundTint="#D69E2E"
            android:text="Ataque Rápido (15)" />
    </GridLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAFC"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Mi Perfil de Entrenador"
        android:textColor="#2D3748"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="Avatar Entrenador" />

    <TextView
        android:id="@+id/tvProfileEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="entrenador@cesba.edu.mx"
        android:textColor="#4A5568"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Estadísticas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:text="Victorias" android:textColor="#718096" android:textSize="12sp"/>
            <TextView android:text="28" android:textColor="#3182CE" android:textSize="20sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:text="Derrotas" android:textColor="#718096" android:textSize="12sp"/>
            <TextView android:text="14" android:textColor="#E53E3E" android:textSize="20sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:text="Favoritos" android:textColor="#718096" android:textSize="12sp"/>
            <TextView android:text="12" android:textColor="#D69E2E" android:textSize="20sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Medallas Obtenidas:"
        android:textColor="#2D3748"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:text="🏅 Medalla Torre Pokémon (Completada)\n🔥 Medalla Volcán\n💧 Medalla Cascada"
        android:textColor="#4A5568"
        android:textSize="14sp" />

</LinearLayout>